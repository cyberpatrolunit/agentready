{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentready",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "getagentready.dev", "custom_domain": true },
    { "pattern": "www.getagentready.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
